{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jot 1.0 lossless AST envelope",
  "type": "object",
  "required": [
    "format",
    "version",
    "source",
    "metadata",
    "nodes",
    "diagnostics"
  ],
  "properties": {
    "format": {
      "const": "jot"
    },
    "version": {
      "const": "1.0"
    },
    "source": {
      "type": "string"
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "metadataRange": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "links": {
      "type": "array",
      "description": "Derived: every internal link (spec 4.2.2). Rebuildable from source.",
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "type",
        "start",
        "end",
        "raw"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "recordType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "unparsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchor": {
          "type": "string",
          "description": "This node is a link target: its record ID or its entry date (spec 4.2.2)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "record"
              }
            }
          },
          "then": {
            "required": [
              "recordType",
              "fields",
              "unparsed"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            }
          },
          "then": {
            "required": [
              "level",
              "text"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "severity",
        "code",
        "message",
        "start",
        "end"
      ],
      "properties": {
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "href",
        "target",
        "start",
        "end",
        "node"
      ],
      "properties": {
        "href": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "node": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
