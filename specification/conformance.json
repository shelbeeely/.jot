{
  "format": "jot-conformance",
  "version": 1,
  "cases": [
    {
      "id": "minimal",
      "input": "A quiet morning.\n",
      "expected": "One undated paragraph, valid Core."
    },
    {
      "id": "urgent",
      "input": "[!] Photograph the cable\n",
      "expected": "Open task with high priority."
    },
    {
      "id": "bare-status",
      "input": "[x]\n",
      "expected": "Paragraph; a task marker requires a following space."
    },
    {
      "id": "uppercase",
      "input": "I AM TIRED\n",
      "expected": "Paragraph; no implicit voice."
    },
    {
      "id": "annotation",
      "input": "[[A spare key]]\n",
      "expected": "Marginalia, not a wiki link."
    },
    {
      "id": "literal",
      "input": "```\n[ ] literal\n```\n",
      "expected": "One literal block; no task."
    },
    {
      "id": "escaped",
      "input": "\\[ ] literal\n",
      "expected": "Paragraph displayed as [ ] literal."
    },
    {
      "id": "month",
      "input": "### 2026-10-25\nRain.\n\n### 2026-10-26\nSun.\n",
      "expected": "Two dated entries in one document."
    },
    {
      "id": "same-day",
      "input": "### 2026-10-25\nMorning.\n### 2026-10-25\nEvening.\n",
      "expected": "Two distinct entries, same date, source order."
    },
    {
      "id": "invalid-date",
      "input": "### 2026-02-30\n",
      "expected": "Heading retained; invalid-date diagnostic."
    },
    {
      "id": "unknown",
      "input": ":::record x-test #a\nstrange: retained\n:::\n",
      "expected": "Unknown record and field preserved."
    },
    {
      "id": "unclosed",
      "input": ":::record reflection\nbody: unfinished\n",
      "expected": "Error unclosed-record; raw preserved through EOF."
    },
    {
      "id": "duplicate",
      "input": ":::record reflection #a\n:::\n:::record reflection #a\n:::\n",
      "expected": "duplicate-id error; links to a unresolved."
    },
    {
      "id": "zero",
      "input": ":::record measurement\nmetric: effort\nstatus: observed\nvalue: 0\n:::\n",
      "expected": "Observed numeric zero, not missing."
    },
    {
      "id": "missing",
      "input": ":::record measurement\nmetric: effort\nstatus: unknown\n:::\n",
      "expected": "Unknown observation, no numeric value."
    },
    {
      "id": "multiline",
      "input": ":::record reflection\nbody: |\n  :::\n  # literal heading\n:::\n",
      "expected": "body contains literal ::: and # literal heading."
    },
    {
      "id": "crlf",
      "input": "Paragraph.  \r\n\r\n",
      "expected": "Lossless source remains byte-identical including CRLF and spaces."
    },
    {
      "id": "unicode",
      "input": "A moon 🌙\n",
      "expected": "UTF-8 byte offsets, not character offsets."
    }
  ]
}
