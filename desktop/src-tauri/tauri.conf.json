{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jot",
  "version": "0.1.0",
  "identifier": "io.github.shelbeeely.jot",
  "build": {
    "frontendDist": "../../site/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://api.spotify.com https://accounts.spotify.com https://ws.audioscrobbler.com https://api.listenbrainz.org https://openrouter.ai https://huggingface.co https://*.cdn.hf.co https://api.open-meteo.com https://archive-api.open-meteo.com https://musicbrainz.org https://www.wikidata.org https://api.tvmaze.com https://openlibrary.org https://graphql.anilist.co https://itunes.apple.com https://www.youtube.com https://open.spotify.com http://localhost:* http://127.0.0.1:* http://[::1]:* https://localhost:* https://127.0.0.1:* https://[::1]:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "blob:"
      }
    }
  },
  "bundle": {
    "macOS": {"infoPlist": "Info.plist", "entitlements": "Entitlements.plist"},
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Jot things down. Get beautiful pages back.",
    "longDescription": "Jot is a journal you write in plain text and read as beautiful pages, one thought at a time. Your journals stay ordinary files on your device: no account, nothing uploaded.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "jotz"
        ],
        "name": "Jot journal archive",
        "description": "Jotz v1 journal archive",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-jotz",
        "exportedType": {
          "identifier": "io.github.shelbeeely.jot.package",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      },
      {
        "ext": [
          "jot"
        ],
        "name": "Jot journal",
        "description": "Jot journal",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/x-jot",
        "exportedType": {
          "identifier": "io.github.shelbeeely.jot.journal",
          "conformsTo": [
            "public.plain-text"
          ]
        }
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/io.github.shelbeeely.jot.xml": "linux/jot-mime.xml",
          "/usr/share/icons/hicolor/scalable/mimetypes/io.github.shelbeeely.jot-document.svg": "linux/jot-document.svg"
        },
        "postInstallScript": "linux/refresh.sh",
        "postRemoveScript": "linux/refresh.sh",
        "desktopTemplate": "linux/jot.desktop"
      }
    }
  }
}
